{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "missing": [{ "type": "host", "value": "(?<slug>[a-z0-9-]+)\\.preview\\.vincereai\\.tech" }],
      "destination": "https://vincereai.tech",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(?<slug>[a-z0-9-]+)\\.preview\\.vincereai\\.tech" }],
      "destination": "/:slug.html"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(?<slug>[a-z0-9-]+)\\.preview\\.vincereai\\.tech" }],
      "destination": "/:slug/robots.txt"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<slug>[a-z0-9-]+)\\.preview\\.vincereai\\.tech" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
