---
import Layout from '../layouts/Layout.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HeroCircle from '../components/HeroCircle.astro';
import Approach from '../components/Approach.astro';
import Journey from '../components/Journey.astro';
import FactsStrip from '../components/FactsStrip.astro';
import About from '../components/About.astro';
import Conditions from '../components/Conditions.astro';
import FirstVisit from '../components/FirstVisit.astro';
import Telehealth from '../components/Telehealth.astro';
import Faq from '../components/Faq.astro';
import Location from '../components/Location.astro';
import LotusDivider from '../components/LotusDivider.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import type { GetStaticPaths } from 'astro';
import { clinics } from '../clinics';
import type { ClinicConfig } from '../clinics/types';
import { getCopy } from '../lib/copy';

/** Uma página estática por clínica: /animus, /outra-clinica… */
export const getStaticPaths = (() => clinics.map((clinic) => ({ params: { slug: clinic.slug }, props: { clinic } }))) satisfies GetStaticPaths;

const { clinic } = Astro.props as { clinic: ClinicConfig };
const copy = getCopy(clinic);
---

<Layout clinic={clinic}>
  <a
    href="#conteudo"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >Pular para o conteúdo</a
  >
  {clinic.isPreview && <PreviewBanner text={clinic.previewBanner} suffix={copy.previewSuffix} />}
  <Header clinic={clinic} />
  <main id="conteudo" data-tone-root data-tone="base">
    <div class:list={['hero-wrap relative', clinic.style?.finish === 'editorial' && 'overflow-hidden']}>
      {clinic.style?.finish === 'editorial' && <div class="aurora" aria-hidden="true" />}
      {clinic.style?.hero === 'circle' ? <HeroCircle clinic={clinic} /> : <Hero clinic={clinic} />}
    </div>
    <FactsStrip clinic={clinic} />
    <About clinic={clinic} />
    <LotusDivider src={clinic.clinic.logoMark} />
    <Approach clinic={clinic} />
    <Journey clinic={clinic} />
    <Conditions clinic={clinic} />
    <FirstVisit clinic={clinic} />
    {clinic.modalities.teleconsulta && <Telehealth clinic={clinic} />}
    <Faq clinic={clinic} />
    <LotusDivider src={clinic.clinic.logoMark} />
    {clinic.modalities.presencial && <Location clinic={clinic} />}
    <FinalCta clinic={clinic} />
  </main>
  <Footer clinic={clinic} />
  <StickyCta clinic={clinic} />
</Layout>
