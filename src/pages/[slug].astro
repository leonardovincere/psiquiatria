---
import type { GetStaticPaths } from 'astro';
import { clients } from '../clients';
import type { ClientConfig } from '../clients/types';
import { templateFor } from '../templates/registry';

/**
 * Rota única das prévias: uma página estática por cliente (/animus, /outra-clinica…),
 * renderizada pelo template da especialidade (campo `specialty`).
 */
export const getStaticPaths = (() => clients.map((clinic) => ({ params: { slug: clinic.slug }, props: { clinic } }))) satisfies GetStaticPaths;

const { clinic } = Astro.props as { clinic: ClientConfig };
const { Page } = templateFor(clinic);
---

<Page clinic={clinic} />
