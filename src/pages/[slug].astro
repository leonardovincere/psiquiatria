---
import type { GetStaticPaths } from 'astro';
import { clinics } from '../clinics';
import type { ClinicConfig } from '../clinics/types';
import { templateFor } from '../templates/registry';

/** Rota única das prévias: uma página estática por clínica (/animus, /outra-clinica…), no template da especialidade. */
export const getStaticPaths = (() => clinics.map((clinic) => ({ params: { slug: clinic.slug }, props: { clinic } }))) satisfies GetStaticPaths;

const { clinic } = Astro.props as { clinic: ClinicConfig };
const { Page } = templateFor(clinic);
---

<Page clinic={clinic} />
