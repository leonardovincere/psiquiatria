---
import { AGENCY } from '../lib/agency';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Página não encontrada</title>
    <style>
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        background: #f7f7f5;
        color: #1f2328;
        padding: 24px;
        text-align: center;
      }
      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <main>
      <h1 style="font-weight: 500">Página não encontrada</h1>
      <p>Confira o endereço ou visite <a href={AGENCY.url}>{AGENCY.name}</a>.</p>
    </main>
  </body>
</html>
