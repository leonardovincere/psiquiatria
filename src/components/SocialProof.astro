---
import Icon from './Icon.astro';
import type { SocialProof } from '../clinics/types';

/**
 * Apenas o número agregado de avaliações, com link para a fonte.
 * Depoimentos de pacientes não são exibidos (CFM 2.336/2023).
 */
interface Props {
  data: SocialProof;
  class?: string;
}
const { data, class: className = '' } = Astro.props;
---

{
  data.enabled && (
    <a
      href={data.sourceUrl}
      target="_blank"
      rel="noopener"
      class:list={[
        'inline-flex items-center gap-2 text-sm text-muted underline-offset-4 transition hover:text-primary hover:underline',
        className,
      ]}
    >
      <Icon name="external" class="size-4 text-accent" />
      {data.label}
    </a>
  )
}
