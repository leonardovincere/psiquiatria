---
import Icon from './Icon.astro';
import Words from './Words.astro';
import type { ClinicConfig } from '../clinics/types';
import { getCopy } from '../lib/copy';
import { credentials } from '../lib/links';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const { doctor, contact } = clinic;
const copy = getCopy(clinic);
const [lead, ...rest] = doctor.bio;
const links = [
  contact.doctoralia && { href: contact.doctoralia, label: 'Doctoralia', icon: 'calendar' },
  contact.instagram && { href: contact.instagram, label: 'Instagram', icon: 'instagram' },
  contact.facebook && { href: contact.facebook, label: 'Facebook', icon: 'facebook' },
].filter((l) => !!l) as { href: string; label: string; icon: 'calendar' | 'instagram' | 'facebook' }[];
---

<section id="sobre" data-tone-at="base" class="section-y container-page grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-24" aria-labelledby="sobre-titulo">
  <div>
    <p class="eyebrow mb-3.5" data-reveal>{copy.about.eyebrow}</p>
    <h2 id="sobre-titulo" class="text-4xl leading-[1.08] text-ink md:text-5xl" data-words><Words text={doctor.shortName} /></h2>
    <p class="mt-6 text-[15px] leading-relaxed text-muted" data-reveal style="--i:1">
      {doctor.title}<br />
      <span class="font-medium text-ink">{credentials(doctor)}</span>
    </p>
    {
      links.length > 0 && (
        <p class="mt-6 flex gap-2" data-reveal style="--i:2">
          {links.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener"
              aria-label={l.label}
              class="icon-bubble flex size-11 items-center justify-center rounded-full border border-line text-primary transition-colors hover:border-primary"
            >
              <Icon name={l.icon} class="size-[18px]" />
            </a>
          ))}
        </p>
      )
    }
  </div>

  <figure class="relative m-0">
    <!-- Citação: o texto "acende" palavra por palavra ao rolar. -->
    <svg class="mb-4 h-10 w-12 text-accent md:h-14 md:w-16" viewBox="0 0 48 40" fill="currentColor" aria-hidden="true">
      <path d="M0 40V24C0 11 6.5 3 19.5 0l2.5 5C14 7.5 10.5 12.5 10 19h10v21H0Zm26 0V24c0-13 6.5-21 19.5-24l2.5 5C40 7.5 36.5 12.5 36 19h10v21H26Z" />
    </svg>
    {
      lead && (
        <blockquote class="m-0 font-serif text-[1.7rem] leading-[1.3] text-ink md:text-[2.4rem]" data-scrub>
          {lead.split(' ').map((w, i) => (i ? [' ', <span class="sw">{w}</span>] : <span class="sw">{w}</span>))}
        </blockquote>
      )
    }
    <figcaption class="mt-8 flex flex-col gap-3 pt-6 text-[15px] text-muted" data-rule>
      {rest.map((p) => <p class="text-base leading-relaxed text-muted md:text-lg" data-reveal>{p}</p>)}
      {doctor.education.length > 0 && !doctor.experience?.length && <p data-reveal style="--i:1">{doctor.education.join(' · ')}</p>}
    </figcaption>
  </figure>
</section>
