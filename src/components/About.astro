---
import type { ClinicConfig } from '../clinics/types';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const { doctor, contact } = clinic;
const [lead, ...rest] = doctor.bio;
const links = [
  contact.doctoralia && { href: contact.doctoralia, label: 'Doctoralia' },
  contact.instagram && { href: contact.instagram, label: 'Instagram' },
  contact.facebook && { href: contact.facebook, label: 'Facebook' },
].filter((l) => !!l) as { href: string; label: string }[];
---

<section id="sobre" class="section-y container-page grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-24" aria-labelledby="sobre-titulo">
  <div data-reveal>
    <p class="eyebrow mb-3.5">Sobre</p>
    <h2 id="sobre-titulo" class="text-4xl leading-[1.08] text-ink md:text-5xl">{doctor.shortName}</h2>
    <p class="mt-6 text-[15px] leading-relaxed text-muted">
      {doctor.title}<br />
      <span class="font-medium text-ink">{doctor.crm} · {doctor.rqe}</span>
    </p>
  </div>

  <div class="flex flex-col gap-6">
    {lead && <p class="font-serif text-2xl leading-snug text-ink md:text-[2rem] md:leading-[1.35]" data-reveal>{lead}</p>}
    {
      rest.map((p, i) => (
        <p class="text-lg leading-relaxed text-muted md:text-[19px]" data-reveal style={`--i:${i + 1}`}>
          {p}
        </p>
      ))
    }
    <div class="flex flex-wrap items-center justify-between gap-4 pt-6" data-rule>
      {doctor.education.length > 0 && <p class="text-base text-ink/85">{doctor.education.join(' · ')}</p>}
      {
        links.length > 0 && (
          <p class="flex gap-5 text-[15px]">
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener" class="text-primary underline-offset-4 hover:underline">
                {l.label}
              </a>
            ))}
          </p>
        )
      }
    </div>
  </div>
</section>
