---
import Icon from './Icon.astro';
import SocialProof from './SocialProof.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import type { ClinicConfig } from '../clinics/types';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const { doctor, modalities } = clinic;
const { city, state } = clinic.clinic;

const modalityText =
  modalities.presencial && modalities.teleconsulta
    ? 'Consultas presenciais e por teleconsulta.'
    : modalities.teleconsulta
      ? 'Consultas por teleconsulta.'
      : 'Consultas presenciais.';
---

<section id="inicio" class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute -top-40 right-[-10rem] size-[28rem] rounded-full bg-secondary/25 blur-3xl md:size-[40rem]"
    aria-hidden="true"
  >
  </div>
  <div class="container-page relative pt-14 pb-16 md:pt-24 md:pb-28">
    <div class="max-w-3xl">
      <p class="mb-5 text-sm font-medium tracking-wide text-primary uppercase">
        Psiquiatria · {clinic.audience} · {city}/{state}
      </p>
      <h1 class="text-4xl leading-[1.1] font-medium text-ink sm:text-5xl md:text-6xl">{clinic.clinic.tagline}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
        Atendimento com {doctor.shortName}, {doctor.title.toLowerCase()} em {city}. {modalityText}
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <WhatsAppButton clinic={clinic} />
        <a
          href="#primeira-consulta"
          class="inline-flex items-center justify-center rounded-full border border-accent px-6 py-3.5 font-medium text-ink transition hover:bg-accent/15"
        >
          Como funciona a primeira consulta
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted">
        {
          modalities.presencial && (
            <li class="flex items-center gap-2">
              <Icon name="pin" class="size-4 text-primary" />
              Presencial em {city}
            </li>
          )
        }
        {
          modalities.teleconsulta && (
            <li class="flex items-center gap-2">
              <Icon name="video" class="size-4 text-primary" />
              Teleconsulta
            </li>
          )
        }
        {
          clinic.compliance.showCrmRqeEverywhere && (
            <li class="flex items-center gap-2">
              <Icon name="shield" class="size-4 text-primary" />
              {doctor.crm} · {doctor.rqe}
            </li>
          )
        }
      </ul>
      <SocialProof data={clinic.socialProof} class="mt-4" />
    </div>
  </div>
</section>
