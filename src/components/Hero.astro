---
import { getHeroPhoto, heroPhotoSizes } from '../lib/heroPhoto';
import type { ClinicConfig } from '../clinics/types';
import { credentials, initials } from '../lib/links';
import { getCopy } from '../lib/copy';
import { heightFor } from '../lib/assetSize';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const { doctor } = clinic;
const photo = await getHeroPhoto(clinic);
const copy = getCopy(clinic);
const { tagline, taglineHighlight, heroEyebrow, logoMark } = clinic.clinic;
const lotusH = logoMark ? await heightFor(logoMark, 240) : 0;

// Divide a tagline em volta do trecho destacado.
const idx = taglineHighlight ? tagline.indexOf(taglineHighlight) : -1;
const [before, mark, after] =
  idx >= 0
    ? [tagline.slice(0, idx), taglineHighlight!, tagline.slice(idx + taglineHighlight!.length)]
    : [tagline, '', ''];

---

<!--
  Celular: texto e, abaixo, a foto que sai do arco e se abre até a largura da tela.
  Desktop: duas colunas (texto | foto em arco). O texto aparece de imediato
  (é o maior elemento da primeira tela); só os detalhes decorativos animam.
-->
<section id="inicio" data-tone-at="base" class="container-page grid items-center gap-x-20 pt-8 md:pt-14 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:pt-16 lg:pb-24 xl:gap-x-28">
  <div class="flex flex-col gap-6 pb-10 md:pb-14 lg:pb-0">
    <p class="eyebrow">{heroEyebrow ?? copy.hero.eyebrowFallback}</p>
    <h1 class="text-[2.75rem] leading-[1.04] text-ink sm:text-6xl lg:text-[4.5rem] xl:text-[5.25rem]">
      {before}{mark && <em class="mark text-primary">{mark}</em>}{after}
    </h1>
    <p class="max-w-xl text-lg leading-relaxed text-muted md:text-xl">
      {copy.hero.subtitle}
    </p>
    <a
      href="#primeira-consulta"
      class="arrow-nudge inline-flex min-h-12 items-center gap-2 self-start font-medium text-primary"
    >
      <span class="underline decoration-accent decoration-2 underline-offset-[7px]">{copy.hero.link}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <!-- Foto que sai do arco e se abre até a largura da tela conforme a rolagem (--p de 0 a 1, via JS). -->
  <div class="expand -mx-5 mt-16 md:mx-auto md:mt-20 md:w-full md:max-w-[620px] lg:mt-12 lg:max-w-[460px] xl:max-w-[520px]" data-expand>
    <figure class="expand-frame relative mx-auto">
      {
        logoMark && (
          <img
            src={logoMark}
            alt=""
            aria-hidden="true"
            width="240"
            height={lotusH}
            class="hero-lotus pointer-events-none absolute -top-[4.6rem] left-1/2 z-10 w-[190px] md:w-[240px]"
          />
        )
      }
      <div class="expand-photo relative overflow-hidden bg-surface">
        {
          photo ? (
            <img
              src={photo.src}
              srcset={photo.srcSet.attribute}
              sizes={heroPhotoSizes}
              width={photo.attributes.width}
              height={photo.attributes.height}
              alt={`Foto de ${doctor.name}`}
              class="size-full object-cover"
              decoding="async"
              fetchpriority="high"
            />
          ) : (
            <div class="flex size-full items-center justify-center font-serif text-8xl text-primary" aria-hidden="true">
              {initials(doctor.name)}
            </div>
          )
        }
      </div>
      <figcaption class="id-card hero-in absolute bottom-4 left-4 rounded-2xl border border-line bg-white px-5 py-4 shadow-[0_18px_40px_-24px_color-mix(in_srgb,var(--ink-base)_40%,transparent)] md:bottom-6 md:left-6" style="--d:2">
        <span class="block font-serif text-xl text-[var(--ink-base)]">{doctor.shortName}</span>
        <span class="mt-0.5 block text-[13px] text-[var(--muted-base)]">{doctor.title} · {credentials(doctor)}</span>
      </figcaption>
    </figure>
  </div>
</section>
