---
import { Image } from 'astro:assets';
import Words from './Words.astro';
import type { ClinicConfig } from '../clinics/types';
import { initials } from '../lib/links';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const { doctor, modalities } = clinic;
const { city, state, tagline, taglineHighlight, heroEyebrow, logoMark } = clinic.clinic;

// Divide a tagline em volta do trecho destacado.
const idx = taglineHighlight ? tagline.indexOf(taglineHighlight) : -1;
const [before, mark, after] =
  idx >= 0
    ? [tagline.slice(0, idx), taglineHighlight!, tagline.slice(idx + taglineHighlight!.length)]
    : [tagline, '', ''];
const nBefore = before.trim().split(/\s+/).filter(Boolean).length;

const modalityText =
  modalities.presencial && modalities.teleconsulta
    ? 'Consultas presenciais e por teleconsulta.'
    : modalities.teleconsulta
      ? 'Consultas por teleconsulta.'
      : 'Consultas presenciais.';
---

<section id="inicio" data-tone-at="base">
  <div class="container-page flex max-w-[52rem] flex-col gap-6 pt-8 pb-10 md:pt-16 md:pb-14">
    <p class="eyebrow hero-in" style="--d:0">{heroEyebrow ?? `Psiquiatria · ${clinic.audience} · ${city}/${state}`}</p>
    <h1 class="hero-words text-[2.75rem] leading-[1.04] text-ink sm:text-6xl lg:text-[4.75rem]">
      <Words text={before} />{
        mark && (
          <em class="mark text-primary">
            <Words text={mark} from={nBefore} />
          </em>
        )
      }<Words text={after} from={nBefore + 1} />
    </h1>
    <p class="hero-in max-w-xl text-lg leading-relaxed text-muted md:text-xl" style="--d:5">
      Com a {doctor.shortName}, {doctor.title.toLowerCase()} em {city}. {modalityText}
    </p>
    <a
      href="#primeira-consulta"
      class="hero-in arrow-nudge inline-flex min-h-12 items-center gap-2 self-start font-medium text-primary"
      style="--d:6"
    >
      <span class="underline decoration-accent decoration-2 underline-offset-[7px]">Como funciona a primeira consulta</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <!-- Foto que sai do arco e se abre até a largura da tela conforme a rolagem (--p de 0 a 1, via JS). -->
  <div class="expand mx-auto mt-16 w-full md:mt-20 md:max-w-[680px] md:px-8" data-expand>
    <figure class="expand-frame relative mx-auto">
      {
        logoMark && (
          <img
            src={logoMark}
            alt=""
            aria-hidden="true"
            width="240"
            height="141"
            class="hero-lotus pointer-events-none absolute -top-[4.6rem] left-1/2 z-10 w-[190px] md:w-[240px]"
          />
        )
      }
      <div class="expand-photo relative overflow-hidden bg-surface">
        {
          doctor.photo ? (
            <Image
              src={doctor.photo}
              inferSize
              alt={`Foto de ${doctor.name}`}
              widths={[390, 680]}
              sizes="(min-width: 768px) 620px, 100vw"
              class="size-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div class="flex size-full items-center justify-center font-serif text-8xl text-primary" aria-hidden="true">
              {initials(doctor.name)}
            </div>
          )
        }
      </div>
      <figcaption class="hero-in absolute bottom-4 left-4 rounded-2xl border border-line bg-white px-5 py-4 shadow-[0_18px_40px_-24px_rgba(28,43,61,0.4)] md:bottom-6 md:left-6" style="--d:7">
        <span class="block font-serif text-xl text-[var(--ink-base)]">{doctor.shortName}</span>
        <span class="mt-0.5 block text-[13px] text-[var(--muted-base)]">{doctor.title} · {doctor.crm} · {doctor.rqe}</span>
      </figcaption>
    </figure>
  </div>
</section>
