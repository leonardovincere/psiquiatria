---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { ClinicConfig } from '../clinics/types';
import { formatAddress, mapsEmbedUrl, mapsSearchUrl } from '../lib/links';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const { address, contact } = clinic;
const t = clinic.texts.location;
---

<section id="localizacao" class="section-y" aria-labelledby="localizacao-titulo">
  <div class="container-page grid gap-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16">
    <div>
      <SectionHeading id="localizacao-titulo" title={t.title} intro={t.intro} />
      <address class="space-y-6 not-italic">
        <div class="flex gap-3">
          <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-primary" />
          <div class="text-ink">
            <p>{address.street}</p>
            {address.complement && <p>{address.complement}</p>}
            <p>{address.city} — {address.state} · CEP {address.zip}</p>
            {
              address.notes && (
                <ul class="mt-2 space-y-1 text-sm text-muted">
                  {address.notes.map((n) => <li>{n}</li>)}
                </ul>
              )
            }
          </div>
        </div>
        {
          contact.hours && (
            <div class="flex gap-3">
              <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-primary" />
              <ul class="text-ink">
                {contact.hours.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          )
        }
        {
          contact.phone && (
            <div class="flex gap-3">
              <Icon name="phone" class="mt-0.5 size-5 shrink-0 text-primary" />
              <p class="text-ink">{contact.phone}</p>
            </div>
          )
        }
      </address>
      <a
        href={mapsSearchUrl(address)}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center gap-2 font-medium text-primary underline-offset-4 hover:underline"
      >
        Abrir no Google Maps <Icon name="external" class="size-4" />
      </a>
    </div>

    <!-- Fachada: o iframe do Google Maps (~1 MB de JS) só carrega no clique. -->
    <div
      class="relative aspect-[4/3] overflow-hidden rounded-3xl border border-line bg-surface md:aspect-auto md:min-h-96"
      data-map
      data-src={mapsEmbedUrl(address)}
      data-title={`Mapa: ${formatAddress(address)}`}
    >
      <div
        class="absolute inset-0 opacity-60"
        style="background-image:radial-gradient(var(--c-border) 1px,transparent 1px);background-size:18px 18px"
        aria-hidden="true"
      >
      </div>
      <button
        type="button"
        class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-ink transition hover:text-primary"
      >
        <span class="flex size-14 items-center justify-center rounded-full bg-primary text-on-primary shadow-lg">
          <Icon name="pin" class="size-6" />
        </span>
        <span class="rounded-full bg-background px-4 py-2 text-sm font-medium shadow-sm">Ver mapa interativo</span>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((el) => {
    el.querySelector('button')?.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = el.dataset.src!;
        iframe.title = el.dataset.title!;
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.className = 'absolute inset-0 size-full border-0';
        el.replaceChildren(iframe);
      },
      { once: true },
    );
  });
</script>
