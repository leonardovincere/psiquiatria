---
/** Faixa exibida apenas quando isPreview = true. "Vincere.AI" no texto vira link. */
interface Props {
  text: string;
}
const { text } = Astro.props;
const [before, after] = text.includes('Vincere.AI') ? text.split(/Vincere\.AI(.*)/s) : [text, undefined];
---

<div class="bg-ink px-4 py-2 text-center text-xs text-background sm:text-sm" role="note">
  <span class="font-medium">
    {before}{
      after !== undefined && (
        <>
          <a href="https://vincereai.tech" target="_blank" rel="noopener" class="underline decoration-accent underline-offset-2 hover:text-accent">
            Vincere.AI
          </a>
          {after}
        </>
      )
    }
  </span>
  <span class="opacity-75"> · versão de demonstração, não indexada</span>
</div>
