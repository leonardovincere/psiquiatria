---
import Icon from './Icon.astro';
import Words from './Words.astro';
import type { ClinicConfig } from '../clinics/types';
import { getCopy } from '../lib/copy';
import { heightFor } from '../lib/assetSize';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const copy = getCopy(clinic).telehealth;
const icons = ['video', 'lock', 'doc'] as const;
const points = copy.points.map((text, i) => ({ icon: icons[i], text }));
const titleWords = copy.title.trim().split(/\s+/).length;
const markH = clinic.clinic.logoMark ? await heightFor(clinic.clinic.logoMark, 520) : 0;
---

<!-- Ao chegar aqui, o fundo da página inteira escurece para o azul (data-tone-at="deep"). -->
<section id="teleconsulta" data-tone-at="deep" class="section-y relative overflow-hidden" aria-labelledby="teleconsulta-titulo">
  {
    clinic.clinic.logoMark && (
      <img
        src={clinic.clinic.logoMark}
        alt=""
        aria-hidden="true"
        width="520"
        height={markH}
        loading="lazy"
        class="drift pointer-events-none absolute -right-24 bottom-0 w-[340px] opacity-[0.14] md:right-0 md:w-[560px]"
      />
    )
  }
  <div class="container-page relative">
    <p class="eyebrow mb-3.5" data-reveal>{copy.eyebrow}</p>
    <h2 id="teleconsulta-titulo" class="max-w-3xl text-4xl leading-[1.05] text-ink md:text-[3.5rem]" data-words>
      <Words text={copy.title} /> <em class="text-primary"><Words text={copy.titleEm} from={titleWords} /></em>
    </h2>
    <p class="mt-5 text-lg text-muted md:text-xl" data-reveal>{copy.subtitle}</p>
    <ul class="mt-12 grid gap-6 sm:grid-cols-3 sm:gap-10">
      {
        points.map((p, i) => (
          <li class="flex items-center gap-4 border-t border-line pt-6 text-lg text-ink" data-reveal style={`--i:${i}`}>
            <span class="icon-bubble flex size-12 shrink-0 items-center justify-center rounded-full border border-line text-accent">
              <Icon name={p.icon} class="size-[22px]" />
            </span>
            {p.text}
          </li>
        ))
      }
    </ul>
    <p class="mt-10 max-w-2xl text-[13px] leading-relaxed text-muted" data-reveal>
      {copy.note}
    </p>
  </div>
</section>
