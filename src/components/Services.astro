---
import SectionHeading from './SectionHeading.astro';
import type { ClinicConfig } from '../clinics/types';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
// Teleconsulta só aparece se a modalidade estiver ativa.
const services = clinic.services.filter((s) => clinic.modalities.teleconsulta || !/teleconsulta/i.test(s.name));
const payment = [clinic.insurance.note, clinic.payment.length > 0 && `Formas de pagamento: ${clinic.payment.join(', ')}.`].filter(Boolean);
---

<section id="atendimentos" data-tone-at="base" class="section-y container-page" aria-labelledby="atendimentos-titulo">
  <SectionHeading id="atendimentos-titulo" title="Atendimentos" />
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      services.map((s, i) => (
        <li class="card-light flex flex-col rounded-[22px] border border-line bg-white p-7 transition-colors duration-300 hover:border-primary/40" data-reveal style={`--i:${i}`}>
          <h3 class="text-[1.45rem] leading-tight text-ink">{s.name}</h3>
          <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{s.description}</p>
          {clinic.showPrices && s.price && <p class="mt-auto pt-5 font-medium text-primary">{s.price}</p>}
        </li>
      ))
    }
  </ul>
  <p class="mt-8 text-[15px] leading-relaxed text-muted" data-reveal>{payment.join(' ')}</p>
</section>
