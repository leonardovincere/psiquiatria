---
import WhatsAppButton from './WhatsAppButton.astro';
import type { ClinicConfig } from '../clinics/types';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
---

<!-- Barra fixa de agendamento, apenas no mobile. -->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-background/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur sm:hidden"
>
  <WhatsAppButton clinic={clinic} class="w-full" />
</div>
