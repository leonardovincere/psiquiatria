---
import Icon from './Icon.astro';
import type { ClinicConfig } from '../clinics/types';
import { whatsappUrl } from '../lib/links';
import { getCopy } from '../lib/copy';

interface Props {
  clinic: ClinicConfig;
  label?: string;
  size?: 'md' | 'lg';
  variant?: 'primary' | 'accent';
  class?: string;
}
const { clinic, label = getCopy(clinic).scheduleCta, size = 'lg', variant = 'primary', class: className = '' } = Astro.props;
const sizes = { md: 'min-h-11 px-5 text-sm', lg: 'min-h-14 px-7 text-base md:text-[17px]' };
const variants = {
  primary: 'bg-primary text-on-primary',
  accent: 'bg-accent text-ink-deep',
};
---

<a
  href={whatsappUrl(clinic)}
  target="_blank"
  rel="noopener"
  class:list={[
    'btn-lift inline-flex items-center justify-center gap-2.5 rounded-full font-semibold',
    sizes[size],
    variants[variant],
    className,
  ]}
>
  <Icon name="whatsapp" class={size === 'lg' ? 'size-5' : 'size-4'} />
  <span>{label}</span>
  <span class="sr-only">(abre o WhatsApp em nova aba)</span>
</a>
