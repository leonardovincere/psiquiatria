---
import type { ClinicConfig } from '../clinics/types';
import { assetSize } from '../lib/assetSize';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const logoSize = clinic.clinic.logo ? await assetSize(clinic.clinic.logo) : null;
const nav = [
  { href: '#sobre', label: 'Sobre' },
  { href: '#condicoes', label: 'Condições' },
  { href: '#primeira-consulta', label: 'Primeira consulta' },
  ...(clinic.modalities.teleconsulta ? [{ href: '#teleconsulta', label: 'Teleconsulta' }] : []),
  { href: '#duvidas', label: 'Dúvidas' },
  ...(clinic.modalities.presencial ? [{ href: '#localizacao', label: 'Onde estamos' }] : []),
];
---

<header class="site-header sticky top-0 z-40">
  <div class="container-page flex h-[72px] items-center justify-center gap-4 md:h-20 lg:justify-between">
    {
      clinic.clinic.logo ? (
        <a href="#inicio" class="flex shrink-0 items-center">
          <img
            src={clinic.clinic.logo}
            alt={clinic.clinic.fullName}
            width={logoSize!.width}
            height={logoSize!.height}
            class="h-11 w-auto md:h-12"
            fetchpriority="high"
          />
        </a>
      ) : (
        <a href="#inicio" class="font-serif text-xl text-ink">
          {clinic.clinic.name}
        </a>
      )
    }
    <nav aria-label="Seções" class="hidden lg:block">
      <ul class="flex gap-7 text-[15px] text-muted">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
