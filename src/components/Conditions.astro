---
import SectionHeading from './SectionHeading.astro';
import type { ClinicConfig } from '../clinics/types';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
---

<section id="condicoes" class="section-y border-y border-line bg-white" aria-labelledby="condicoes-titulo">
  <div class="container-page">
    <SectionHeading
      id="condicoes-titulo"
      layout="split"
      title="Condições acompanhadas"
      intro="Algumas das situações mais frequentes no consultório. Se você não encontrou o que está sentindo, fale com a gente — conversamos sobre o seu caso."
    />
    <ol class="grid gap-x-16 md:grid-cols-2">
      {
        clinic.conditions.map((c, i) => (
          <li class="group flex gap-6 py-6 md:py-7" data-rule style={`--i:${i % 2}`}>
            <span class="w-8 shrink-0 pt-1 font-serif text-xl text-primary italic transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div data-reveal style={`--i:${i % 2}`}>
              <h3 class="text-2xl text-ink md:text-[1.65rem]">{c.name}</h3>
              <p class="mt-1.5 leading-relaxed text-muted">{c.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-10 text-sm text-muted" data-reveal>Cada pessoa é única: a avaliação e o plano de cuidado são sempre individualizados.</p>
  </div>
</section>
