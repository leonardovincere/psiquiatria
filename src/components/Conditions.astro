---
import SectionHeading from './SectionHeading.astro';
import type { ClinicConfig } from '../clinics/types';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const rows = [clinic.conditions, [...clinic.conditions].reverse()];
---

<section id="condicoes" data-tone-at="sand" class="section-y" aria-labelledby="condicoes-titulo">
  <div class="container-page">
    <SectionHeading
      id="condicoes-titulo"
      layout="split"
      title="Condições acompanhadas"
      intro="Não encontrou o que está sentindo? Fale com a gente — conversamos sobre o seu caso."
    />
  </div>
  <!-- Faixas deslizando: a primeira é a lista acessível; as cópias são decorativas. -->
  <div class="marquee">
    {
      rows.map((row, r) => (
        <ul
          class:list={['marquee-track m-0 list-none p-0', r === 1 && 'rev']}
          aria-label={r === 0 ? 'Condições acompanhadas' : undefined}
          aria-hidden={r === 1 ? 'true' : undefined}
        >
          {[...row, ...row].map((c, i) => (
            <li
              aria-hidden={i >= row.length ? 'true' : undefined}
              class:list={[
                'flex items-center gap-3 rounded-full border border-line bg-white px-6 py-3.5 font-serif text-xl whitespace-nowrap text-[var(--ink-base)] md:text-2xl',
                (i + r) % 2 === 1 && 'text-[var(--primary-base)] italic',
                i >= row.length && 'dup',
              ]}
            >
              <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
              {c.name}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
  <p class="container-page mt-10 text-sm text-muted" data-reveal>Cada pessoa é única: a avaliação e o plano de cuidado são sempre individualizados.</p>
</section>
