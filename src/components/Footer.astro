---
import Icon from './Icon.astro';
import type { ClinicConfig } from '../clinics/types';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const { doctor, contact } = clinic;
const year = new Date().getFullYear();
const social = [
  { href: `https://wa.me/${contact.whatsapp}`, label: 'WhatsApp', icon: 'whatsapp' },
  contact.instagram && { href: contact.instagram, label: 'Instagram', icon: 'instagram' },
  contact.facebook && { href: contact.facebook, label: 'Facebook', icon: 'facebook' },
  contact.doctoralia && { href: contact.doctoralia, label: 'Doctoralia', icon: 'calendar' },
].filter((l) => !!l) as { href: string; label: string; icon: 'whatsapp' | 'instagram' | 'facebook' | 'calendar' }[];
---

<footer class="bg-ink-deep pt-14 pb-10 text-[14px] leading-relaxed text-white/75">
  <div class="container-page flex flex-col gap-10">
    <p class="rounded-2xl border border-white/20 px-5 py-4 text-white" role="note">
      Este canal não atende emergências. Em situação de crise ou risco, procure o pronto-socorro mais próximo, ligue para o
      SAMU (192) ou para o CVV (188), disponível 24 horas.
    </p>

    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-10">
        {
          clinic.clinic.logoLight ? (
            <img src={clinic.clinic.logoLight} alt={clinic.clinic.fullName} width="471" height="96" class="h-10 w-auto self-start md:self-auto" loading="lazy" />
          ) : (
            <p class="font-serif text-xl text-white">{clinic.clinic.fullName}</p>
          )
        }
        <p>
          <span class="text-white">{doctor.name}</span> · {doctor.title} · {doctor.crm} · {doctor.rqe}
          {clinic.compliance.technicalDirector && (
            <>
              <br />
              Diretor(a) técnico(a): {clinic.compliance.technicalDirector}
            </>
          )}
        </p>
      </div>
      <ul class="flex gap-2">
        {
          social.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                class="flex size-11 items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-accent hover:text-accent"
              >
                <Icon name={s.icon} class="size-[18px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-3 border-t border-white/15 pt-6 text-[13px] text-white/65 md:flex-row md:items-start md:justify-between md:gap-10">
      <p>
        © {year} {clinic.clinic.fullName}. Conteúdo informativo, que não substitui a consulta médica. Publicidade médica
        conforme a Resolução CFM nº 2.336/2023.
      </p>
      <p class="shrink-0">
        Desenvolvido por{' '}
        <a href="https://vincereai.tech" target="_blank" rel="noopener" class="font-medium text-white/85 underline-offset-4 hover:text-accent hover:underline">
          Vincere.AI
        </a>
      </p>
    </div>
  </div>
</footer>
