---
import type { Highlight } from '../../clinics/types';

interface Props {
  /** Fatos em destaque (factsFor). */
  items: Highlight[];
}
const { items } = Astro.props;
---

<section aria-label="Em destaque" data-tone-at="base" class="facts card-light border-y border-line bg-surface">
  <ul class="container-page grid divide-line py-8 sm:grid-cols-3 sm:divide-x md:py-10">
    {
      items.map((it, i) => {
        const body = (
          <>
            {it.value && <span class="block font-serif text-[2rem] leading-none text-primary md:text-[2.6rem]">{it.value}</span>}
            <span class:list={['block text-[15px] text-ink/80', it.value && 'mt-2']}>
              {it.label}
              {it.href && <span class="arrow ml-1 text-primary" aria-hidden="true">↗</span>}
            </span>
            {it.note && <span class="mt-1 block text-[13px] text-muted">{it.note}</span>}
          </>
        );
        return (
          <li class="py-4 sm:px-8 sm:py-0 sm:first:pl-0" data-reveal style={`--i:${i}`}>
            {it.href ? (
              <a href={it.href} target="_blank" rel="noopener" class="arrow-nudge block">
                {body}
              </a>
            ) : (
              body
            )}
          </li>
        );
      })
    }
  </ul>
</section>
