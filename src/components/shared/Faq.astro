---
import Words from './Words.astro';
import type { FaqItem } from '../../clients/types';

interface Props {
  title: string;
  items: FaqItem[];
}
const { title, items } = Astro.props;
---

<section id="duvidas" data-tone-at="sand" class="section-y" aria-labelledby="duvidas-titulo">
  <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-24">
    <h2 id="duvidas-titulo" class="text-4xl leading-[1.08] text-ink md:text-5xl" data-words><Words text={title} /></h2>
    <div class="border-t border-line">
      {
        items.map((item, i) => (
          <details class="faq group border-b border-line" data-reveal style={`--i:${i}`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-medium text-ink transition-colors hover:text-primary md:text-[19px] [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="relative size-4 shrink-0 text-primary" aria-hidden="true">
                <span class="absolute top-1/2 left-0 h-[1.5px] w-4 -translate-y-1/2 bg-current" />
                <span class="absolute top-0 left-1/2 h-4 w-[1.5px] -translate-x-1/2 bg-current transition-transform duration-300 group-open:scale-y-0" />
              </span>
            </summary>
            <div class="faq-body">
              <p class="pb-6 text-[17px] leading-relaxed text-muted">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Abertura suave das respostas (navegadores com interpolate-size). */
  @supports (interpolate-size: allow-keywords) {
    .faq {
      interpolate-size: allow-keywords;
    }
    .faq::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.45s cubic-bezier(0.22, 1, 0.36, 1),
        content-visibility 0.45s allow-discrete;
    }
    .faq[open]::details-content {
      block-size: auto;
    }
  }
</style>
