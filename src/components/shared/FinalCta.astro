---
import WhatsAppButton from './WhatsAppButton.astro';
import type { BaseClientConfig } from '../../clients/types';
import { heightFor } from '../../lib/assetSize';
import { whatsappUrl } from '../../lib/links';

/**
 * CTA final de agendamento. O template pode trocar o símbolo (slot "mark", no lugar do logoMark),
 * pôr um fundo (slot "background") e acrescentar classes à seção (`class`).
 */
interface Props {
  clinic: BaseClientConfig;
  copy: { scheduleCta: string; finalCta: { title: string; titleEm: string; text: string; callPrefix: string } };
  class?: string;
}
const { clinic, copy, class: className } = Astro.props;
const customMark = Astro.slots.has('mark');
const { phone } = clinic.contact;
const markH = clinic.clinic.logoMark ? await heightFor(clinic.clinic.logoMark, 96) : 0;
---

<section id="contato" data-tone-at="base" class:list={['px-5 pb-24 md:pb-32', className]} aria-labelledby="contato-titulo">
  <slot name="background" />
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
    <slot name="mark" />
    {
      !customMark && clinic.clinic.logoMark && (
        <img src={clinic.clinic.logoMark} alt="" aria-hidden="true" width="96" height={markH} loading="lazy" class="w-24" data-reveal />
      )
    }
    <h2 id="contato-titulo" class="text-4xl leading-[1.05] text-ink md:text-[3.5rem]" data-reveal style="--i:1">
      {copy.finalCta.title} <em class="text-primary">{copy.finalCta.titleEm}</em>
    </h2>
    <p class="text-lg leading-relaxed text-muted md:text-[19px]" data-reveal style="--i:2">
      {copy.finalCta.text}
    </p>
    <div data-reveal style="--i:3" class="flex flex-col items-center gap-3">
      <WhatsAppButton href={whatsappUrl(clinic)} label={copy.scheduleCta} />
      {
        phone && (
          <p class="text-sm text-muted">
            {copy.finalCta.callPrefix}{' '}
            <a class="font-medium text-ink hover:text-primary" href={`tel:${phone.replace(/\D/g, '')}`}>
              {phone}
            </a>
          </p>
        )
      }
    </div>
  </div>
</section>
