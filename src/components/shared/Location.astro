---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { BaseClientConfig } from '../../clients/types';
import { formatAddress, hoursList, mapsEmbedUrl, mapsSearchUrl } from '../../lib/links';

interface Props {
  clinic: BaseClientConfig;
  copy: { title: string; mapButton: string; mapsLink: string };
}
const { clinic, copy } = Astro.props;
const { address, contact } = clinic;
const hours = hoursList(clinic.hours);
---

<section id="localizacao" data-tone-at="base" class="section-y" aria-labelledby="localizacao-titulo">
  <div class="container-page grid gap-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-20">
    <div data-reveal>
      <SectionHeading id="localizacao-titulo" title={copy.title} class="!mb-8" />
      <address class="space-y-6 not-italic">
        <div class="flex gap-3">
          <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-primary" />
          <div class="text-ink">
            {address.clinicName && <p class="font-medium">{address.clinicName}</p>}
            <p>{address.street}</p>
            {address.complement && <p>{address.complement}</p>}
            {address.neighborhood && <p>{address.neighborhood}</p>}
            <p>{address.city} — {address.state}{address.zip && ` · CEP ${address.zip}`}</p>
          </div>
        </div>
        {
          hours && hours.length > 0 && (
            <div class="flex gap-3">
              <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-primary" />
              <ul class="text-ink">
                {hours.map((h) => <li>{h}</li>)}
              </ul>
            </div>
          )
        }
        {
          contact.phone && (
            <div class="flex gap-3">
              <Icon name="phone" class="mt-0.5 size-5 shrink-0 text-primary" />
              <a class="text-ink hover:text-primary" href={`tel:${contact.phone.replace(/\D/g, '')}`}>{contact.phone}</a>
            </div>
          )
        }
        {
          contact.email && (
            <div class="flex gap-3">
              <Icon name="external" class="mt-0.5 size-5 shrink-0 text-primary" />
              <a class="text-ink hover:text-primary" href={`mailto:${contact.email}`}>{contact.email}</a>
            </div>
          )
        }
      </address>
      <a
        href={mapsSearchUrl(address)}
        target="_blank"
        rel="noopener"
        class="arrow-nudge mt-8 inline-flex items-center gap-2 font-medium text-primary underline-offset-4 hover:underline"
      >
        {copy.mapsLink} <span class="arrow" aria-hidden="true">↗</span>
      </a>
      {/* Conteúdo extra do template (ex.: convênios), abaixo do endereço. */}
      <slot />
    </div>

    <!-- Fachada: o iframe do Google Maps (~1 MB de JS) só carrega no clique. -->
    <div
      class="map-box card-light relative aspect-[4/3] overflow-hidden rounded-[28px] border border-line bg-[color-mix(in_srgb,var(--primary-base)_7%,white)] md:aspect-auto md:min-h-[22rem]"
      data-reveal
      style="--i:1"
      data-map
      data-src={mapsEmbedUrl(address)}
      data-title={`Mapa: ${formatAddress(address)}`}
    >
      <div
        class="absolute inset-0 opacity-60"
        style="--grid:color-mix(in srgb,var(--primary-base) 14%,white);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:44px 44px"
        aria-hidden="true"
      >
      </div>
      <button
        type="button"
        class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-ink transition hover:text-primary"
      >
        <span class="map-pill inline-flex items-center gap-3 rounded-full bg-white px-5 py-3 text-[15px] font-medium shadow-[0_10px_30px_-18px_color-mix(in_srgb,var(--ink-base)_50%,transparent)] transition-transform duration-300 hover:-translate-y-0.5">
          <span class="relative flex size-3">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-3 rounded-full bg-primary"></span>
          </span>
          {copy.mapButton}
        </span>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((el) => {
    el.querySelector('button')?.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = el.dataset.src!;
        iframe.title = el.dataset.title!;
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.className = 'absolute inset-0 size-full border-0';
        el.replaceChildren(iframe);
      },
      { once: true },
    );
  });
</script>
