---
import SectionHeading from './SectionHeading.astro';
import type { ClinicConfig } from '../clinics/types';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
---

<section id="primeira-consulta" data-tone-at="base" class="section-y container-page" aria-labelledby="primeira-consulta-titulo">
  <SectionHeading
    id="primeira-consulta-titulo"
    eyebrow="Passo a passo"
    title="Como funciona a primeira consulta"
    intro="Uma conversa sem pressa, para conhecer você e entender o momento que está vivendo."
  />
  <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      clinic.firstVisitSteps.map((step, i) => (
        <li class="border-t-2 border-primary pt-6" data-reveal style={`--i:${i}`}>
          <span class="block font-serif text-6xl leading-none text-primary italic" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="mt-5 mb-2 text-2xl text-ink">
            <span class="sr-only">Etapa {i + 1}: </span>
            {step.title}
          </h3>
          <p class="leading-relaxed text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>
