---
import SectionHeading from './SectionHeading.astro';
import type { ClinicConfig } from '../clinics/types';
import { getCopy } from '../lib/copy';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const copy = getCopy(clinic).firstVisit;
// Serviços que não são a própria consulta/retorno/teleconsulta (ex.: laudos) viram uma linha discreta.
const extras = clinic.services.filter((s) => !/primeira|inicial|avalia|acompanhamento|retorno|teleconsulta|online|v[ií]deo/i.test(s.name));
const notes = [
  ...extras.map((s) => `${copy.extraPrefix} ${s.name.toLowerCase()}`),
  clinic.insurance.note,
  clinic.payment?.length && `${copy.paymentPrefix}: ${clinic.payment.join(' ou ').toLowerCase()}`,
].filter(Boolean) as string[];
const cinema = clinic.style?.finish === 'cinema';
---

{
  cinema ? (
    <section id="primeira-consulta" data-tone-at="base" class="section-y container-page" aria-labelledby="primeira-consulta-titulo">
      <!-- "cinema": título preso na rolagem à esquerda; as etapas passam como cenas à direita. -->
      <div class="grid gap-4 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-24">
        <div class="lg:sticky lg:top-32 lg:self-start">
          <SectionHeading id="primeira-consulta-titulo" eyebrow={copy.eyebrow} title={copy.title} />
        </div>
        <ol>
          {clinic.firstVisitSteps.map((step, i) => (
            <li class="scene-step grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-5 border-t border-line py-9 md:grid-cols-[7.5rem_minmax(0,1fr)] md:py-14" data-reveal>
              <span class="font-serif text-6xl leading-[0.85] text-primary italic md:text-8xl" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="self-center">
                <h3 class="mb-2 text-[1.75rem] leading-tight text-ink md:text-[2.2rem]">
                  <span class="sr-only">Etapa {i + 1}: </span>
                  {step.title}
                </h3>
                <p class="text-[17px] leading-relaxed text-muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      {notes.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2 border-t border-line pt-6 text-[15px] text-muted" data-reveal>
          {notes.map((n) => (
            <li class="flex items-center gap-2.5">
              <span class="dot size-1.5 rounded-full bg-accent" aria-hidden="true" />
              {n.replace(/\.$/, '')}
            </li>
          ))}
        </ul>
      )}
    </section>
  ) : (
<section id="primeira-consulta" data-tone-at="base" class="section-y container-page" aria-labelledby="primeira-consulta-titulo">
  <SectionHeading
    id="primeira-consulta-titulo"
    eyebrow={copy.eyebrow}
    title={copy.title}
  />
  <ol class="grid gap-7 sm:grid-cols-2 sm:gap-10 lg:grid-cols-4">
    {
      clinic.firstVisitSteps.map((step, i) => (
        <li class="flex gap-5 border-t-2 border-primary pt-5 sm:block sm:pt-6" data-reveal style={`--i:${i}`}>
          <span class="block w-9 shrink-0 font-serif text-5xl leading-none text-primary italic sm:w-auto sm:text-6xl" aria-hidden="true">
            {i + 1}
          </span>
          <div>
          <h3 class="mb-1.5 text-2xl text-ink sm:mt-5">
            <span class="sr-only">Etapa {i + 1}: </span>
            {step.title}
          </h3>
          <p class="leading-relaxed text-muted">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
  {
    notes.length > 0 && (
      <ul class="mt-14 flex flex-wrap gap-x-8 gap-y-2 border-t border-line pt-6 text-[15px] text-muted" data-reveal>
        {notes.map((n) => (
          <li class="flex items-center gap-2.5">
            <span class="dot size-1.5 rounded-full bg-accent" aria-hidden="true" />
            {n.replace(/\.$/, '')}
          </li>
        ))}
      </ul>
    )
  }
</section>
  )
}
