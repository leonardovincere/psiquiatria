---
import { Font } from 'astro:assets';
import '../styles/global.css';
import type { ClinicConfig } from '../clinics/types';
import { readableOn } from '../lib/links';
import { getHeroPhoto, heroPhotoSizes } from '../lib/heroPhoto';

interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const { theme: t, seo, doctor, address, contact } = clinic;

const cssVars = [
  `--c-primary:${t.primary}`,
  `--c-on-primary:${readableOn(t.primary)}`,
  `--c-secondary:${t.secondary}`,
  `--c-accent:${t.accent}`,
  `--c-background:${t.background}`,
  `--c-text:${t.text}`,
].join(';');

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const heroPhoto = await getHeroPhoto(clinic);

const sameAs = [contact.doctoralia, contact.instagram, contact.facebook].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: clinic.clinic.fullName,
  description: seo.description,
  url: canonical,
  telephone: contact.phone ?? `+${contact.whatsapp}`,
  medicalSpecialty: 'Psychiatric',
  address: {
    '@type': 'PostalAddress',
    streetAddress: [address.street, address.complement].filter(Boolean).join(', '),
    addressLocality: address.city,
    addressRegion: address.state,
    postalCode: address.zip,
    addressCountry: 'BR',
  },
  ...(address.coords
    ? { geo: { '@type': 'GeoCoordinates', latitude: address.coords.lat, longitude: address.coords.lng } }
    : {}),
  ...(sameAs.length ? { sameAs } : {}),
  employee: {
    '@type': 'Physician',
    name: doctor.name,
    medicalSpecialty: 'Psychiatric',
    identifier: [doctor.crm, doctor.rqe],
  },
};
---

<!doctype html>
<html lang="pt-BR" style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.keywords.length > 0 && <meta name="keywords" content={seo.keywords.join(', ')} />}
    {
      clinic.isPreview ? (
        <meta name="robots" content="noindex, nofollow, noarchive" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={t.primary} />
    {
      clinic.clinic.favicon ? (
        <link rel="icon" href={clinic.clinic.favicon} />
      ) : (
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      )
    }
    {clinic.clinic.appleTouchIcon && <link rel="apple-touch-icon" href={clinic.clinic.appleTouchIcon} />}

    <!-- Foto do topo primeiro: é o maior elemento da primeira tela no celular. -->
    {
      heroPhoto && (
        <link
          rel="preload"
          as="image"
          href={heroPhoto.src}
          imagesrcset={heroPhoto.srcSet.attribute}
          imagesizes={heroPhotoSizes}
          fetchpriority="high"
        />
      )
    }
    <!-- Fontes auto-hospedadas; pré-carrega só o que aparece na primeira tela. -->
    <Font cssVariable="--f-heading" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--f-body" preload={[{ weight: '400', style: 'normal' }]} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={clinic.clinic.fullName} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    {doctor.photo && <meta property="og:image" content={doctor.photo} />}
    <meta name="format-detection" content="telephone=no" />

    {!clinic.isPreview && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-dvh antialiased">
    <slot />
    <script>
      // Revelação ao rolar: marca [data-reveal] e [data-rule] como visíveis uma única vez.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-rule], [data-words]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Tom de fundo: segue a seção que cruza o meio da tela.
      const root = document.querySelector<HTMLElement>('[data-tone-root]');
      if (root && 'IntersectionObserver' in window) {
        const toneIO = new IntersectionObserver(
          (entries) => {
            for (const e of entries) if (e.isIntersecting) root.dataset.tone = (e.target as HTMLElement).dataset.toneAt;
          },
          { rootMargin: '-48% 0px -48% 0px' },
        );
        root.querySelectorAll('[data-tone-at]').forEach((el) => toneIO.observe(el));
      }

      // Efeitos guiados pela rolagem: foto que se abre e texto que acende.
      const expand = document.querySelector<HTMLElement>('[data-expand]');
      const scrubs = [...document.querySelectorAll<HTMLElement>('[data-scrub]')].map((el) => ({
        el,
        words: [...el.querySelectorAll<HTMLElement>('.sw')],
      }));
      const clamp = (v: number) => Math.min(1, Math.max(0, v));
      const frame = () => {
        const vh = innerHeight;
        if (expand) {
          const r = expand.getBoundingClientRect();
          expand.style.setProperty('--p', clamp((vh * 0.75 - r.top) / (vh * 0.6)).toFixed(3));
        }
        for (const { el, words } of scrubs) {
          const r = el.getBoundingClientRect();
          const lit = Math.round(clamp((vh * 0.85 - r.top) / (r.height + vh * 0.35)) * words.length);
          words.forEach((w, i) => w.classList.toggle('on', i < lit));
        }
      };
      if (!reduce) {
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            frame();
            ticking = false;
          });
        };
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
        frame();
      }

      // Cabeçalho ganha fundo depois que a página rola.
      const header = document.querySelector('.site-header');
      if (header) {
        const sentinel = document.createElement('div');
        sentinel.style.cssText = 'position:absolute;top:80px;height:1px;width:1px';
        document.body.prepend(sentinel);
        new IntersectionObserver(([e]) => header.classList.toggle('is-scrolled', !e.isIntersecting)).observe(sentinel);
      }
    </script>
  </body>
</html>
