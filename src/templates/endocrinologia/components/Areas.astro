---
import Icon from '../../../components/shared/Icon.astro';
import SectionHeading from '../../../components/shared/SectionHeading.astro';
import { ENDO_ICONS } from '../icons';
import type { Area, EndocrinologiaCopy } from '../types';

interface Props {
  items: Area[];
  copy: EndocrinologiaCopy['areas'];
}
const { items, copy } = Astro.props;
---

<section id="areas" data-tone-at="base" class="section-y container-page" aria-labelledby="areas-titulo">
  <SectionHeading id="areas-titulo" layout="split" eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} />
  <ul class="endo-cards grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((area, i) => (
        <li class="endo-card card-light flex flex-col gap-4 bg-white p-7 md:p-8" data-reveal style={`--i:${i % 3}`}>
          <div class="flex items-start justify-between gap-4">
            <span class="icon-bubble flex size-12 shrink-0 items-center justify-center border border-line text-primary">
              <Icon svg={area.icon ? ENDO_ICONS[area.icon] : ENDO_ICONS.pulse} class="size-6" />
            </span>
            <span class="endo-mono text-[13px] text-muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="text-[1.35rem] leading-snug text-ink">{area.name}</h3>
          <p class="text-[16px] leading-relaxed text-muted">{area.description}</p>
        </li>
      ))
    }
  </ul>
  <p class="mt-8 max-w-2xl text-[15px] text-muted" data-reveal>{copy.note}</p>
</section>
