---
import Words from '../../../components/shared/Words.astro';
import type { ClinicConfig } from '../../../clinics/types';
import { getCopy } from '../copy';

/**
 * Trabalho acadêmico em destaque (config `research`), como a capa de uma
 * publicação: tipo e ano em versalete, título longo em serifa que "acende"
 * palavra por palavra ao rolar, instituição no pé. A seção é uma cena escura
 * (.scene-dark) e escurece a página ao redor (data-tone-at="deep").
 */
interface Props {
  clinic: ClinicConfig;
}
const { clinic } = Astro.props;
const r = clinic.research;
const copy = getCopy(clinic).research;
const meta = r ? [r.kind, r.year].filter(Boolean).join(' · ') : '';
---

{
  r?.enabled && (
    <section id="pesquisa" data-tone-at="deep" class="scene-dark section-y relative overflow-hidden" aria-labelledby="pesquisa-titulo">
      <div class="research-glow pointer-events-none absolute inset-0" aria-hidden="true" />
      <div class="container-page relative grid items-center gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-24">
        <div>
          <p class="eyebrow mb-3.5" data-reveal>
            {copy.eyebrow}
          </p>
          <h2 id="pesquisa-titulo" class="text-4xl leading-[1.08] text-ink md:text-5xl" data-words>
            <Words text={r.heading} />
          </h2>
          {r.summary && (
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted" data-reveal style="--i:1">
              {r.summary}
            </p>
          )}
          {r.link && (
            <a
              href={r.link}
              target="_blank"
              rel="noopener"
              class="arrow-nudge mt-8 inline-flex min-h-12 items-center gap-2 font-medium text-primary underline-offset-4 hover:underline"
              data-reveal
              style="--i:2"
            >
              {copy.link} <span class="arrow" aria-hidden="true">↗</span>
            </a>
          )}
        </div>

        <figure class="research-cover m-0 border border-line p-7 sm:p-10 md:p-14" data-reveal style="--i:1">
          <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line pb-5 text-[12px] font-semibold tracking-[0.2em] text-primary uppercase">
            <span>{meta}</span>
            <span class="text-muted">{clinic.doctor.name}</span>
          </figcaption>
          <blockquote class="m-0 py-10 font-serif text-[1.55rem] leading-[1.25] text-ink italic sm:text-[1.9rem] md:py-14 md:text-[2.3rem]" data-scrub>
            {r.title.split(' ').map((w, i) => (i ? [' ', <span class="sw">{w}</span>] : <span class="sw">{w}</span>))}
          </blockquote>
          <p class="border-t border-line pt-5 text-[12px] leading-relaxed tracking-[0.16em] text-muted uppercase">{r.institution}</p>
        </figure>
      </div>
    </section>
  )
}
