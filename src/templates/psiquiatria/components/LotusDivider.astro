---
import { heightFor } from '../../../lib/assetSize';

/** Pausa visual entre seções: flor de lótus entre dois filetes. */
interface Props {
  src?: string | null;
}
const { src } = Astro.props;
const h = src ? await heightFor(src, 44) : 0;
---

{
  src && (
    <div class="container-page flex items-center gap-5" aria-hidden="true" data-reveal>
      <span class="h-px flex-1 bg-line" />
      <img src={src} alt="" width="44" height={h} loading="lazy" class="w-11" />
      <span class="h-px flex-1 bg-line" />
    </div>
  )
}
