---
import SectionHeading from '../../../components/shared/SectionHeading.astro';
import type { PsiquiatriaClient } from '../types';
import { getCopy } from '../copy';

interface Props {
  clinic: PsiquiatriaClient;
}
const { clinic } = Astro.props;
const copy = getCopy(clinic).conditions;
const rows = [clinic.conditions, [...clinic.conditions].reverse()];
---

<section id="condicoes" data-tone-at="sand" class="section-y" aria-labelledby="condicoes-titulo">
  <div class="container-page">
    <SectionHeading
      id="condicoes-titulo"
      layout="split"
      title={copy.title}
      intro={copy.intro}
    />
  </div>
  <!-- "chips": etiquetas fixas. Padrão: faixas deslizando (a primeira é a lista acessível; as cópias são decorativas). -->
  {
    clinic.style?.conditions === 'chips' ? (
      <ul class="container-page flex flex-wrap gap-3 md:gap-4" aria-label={copy.title}>
        {clinic.conditions.map((c, i) => (
          <li
            class="chip flex items-center gap-3 rounded-full border border-line bg-white px-6 py-3.5 font-serif text-xl text-[var(--ink-base)] md:px-7 md:py-4 md:text-2xl"
            data-reveal
            style={`--i:${i}`}
          >
            <span class="dot size-1.5 rounded-full bg-accent" aria-hidden="true" />
            {c.name}
          </li>
        ))}
      </ul>
    ) : (
  <div class="marquee">
    {
      rows.map((row, r) => (
        <ul
          class:list={['marquee-track m-0 list-none p-0', r === 1 && 'rev']}
          aria-label={r === 0 ? copy.title : undefined}
          aria-hidden={r === 1 ? 'true' : undefined}
        >
          {[...row, ...row].map((c, i) => (
            <li
              aria-hidden={i >= row.length ? 'true' : undefined}
              class:list={[
                'chip flex items-center gap-3 rounded-full border border-line bg-white px-6 py-3.5 font-serif text-xl whitespace-nowrap text-[var(--ink-base)] md:text-2xl',
                (i + r) % 2 === 1 && 'text-[var(--primary-base)] italic',
                i >= row.length && 'dup',
              ]}
            >
              <span class="dot size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
              {c.name}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
    )
  }
  <p class="container-page mt-10 text-sm text-muted" data-reveal>{copy.note}</p>
</section>
