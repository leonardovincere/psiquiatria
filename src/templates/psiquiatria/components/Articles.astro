---
import SectionHeading from '../../../components/shared/SectionHeading.astro';
import type { PsiquiatriaClient } from '../types';
import { getCopy } from '../copy';

/** Conteúdo educativo (config `articles`): perguntas comuns com resposta curta, em colunas numeradas. */
interface Props {
  clinic: PsiquiatriaClient;
}
const { clinic } = Astro.props;
const a = clinic.articles;
const copy = getCopy(clinic).articles;
---

{
  a?.enabled && a.items.length > 0 && (
    <section id="conteudo-educativo" data-tone-at="sand" class="section-y container-page" aria-labelledby="conteudo-educativo-titulo">
      <SectionHeading id="conteudo-educativo-titulo" layout="split" eyebrow={copy.eyebrow} title={a.heading} intro={a.intro ?? undefined} />
      <ol class="grid gap-10 md:grid-cols-3 md:gap-12">
        {a.items.map((it, i) => {
          const body = (
            <>
              <span class="block text-[13px] font-semibold tracking-[0.2em] text-primary" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 text-[1.75rem] leading-tight text-ink md:text-[2rem]">{it.title}</h3>
              <p class="mt-3 text-[17px] leading-relaxed text-muted">{it.excerpt}</p>
              {it.href && <span class="arrow mt-4 inline-block text-primary" aria-hidden="true">→</span>}
            </>
          );
          return (
            <li class="article pt-6" data-rule style={`--i:${i}`}>
              <div data-reveal style={`--i:${i}`}>
                {it.href ? (
                  <a href={it.href} class="arrow-nudge block">
                    {body}
                  </a>
                ) : (
                  body
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  )
}
